# Copy to .env to override the production Compose defaults.
# Keep credentials in secret files under ML_SECRETS_DIR, not in this file.

# MLflow image
ML_IMAGE_TAG=prod

# PostgreSQL
ML_DB_HOST=db.simovi.org
ML_DB_PORT=5432
ML_DB_NAME=mlflow
ML_DB_USER=mlflow
ML_DB_SSLMODE=verify-full
ML_DB_SSLROOTCERT=/run/secrets/mlflow_db_ca
# Keep ML_WORKERS x 3 x (pool size + overflow) below the server's max_connections
ML_DB_POOL_SIZE=5
ML_DB_MAX_OVERFLOW=10
ML_DB_POOL_RECYCLE=1800

# MinIO / S3
MLFLOW_S3_ENDPOINT_URL=https://s3.simovi.org
ML_BUCKET=mlflow
# SigV4 signing region; must match the endpoint on non-MinIO S3 services
ML_S3_REGION=us-east-1

# MLflow server
ML_WORKERS=4
ML_AUTH_DEFAULT_PERMISSION=NO_PERMISSIONS
MLFLOW_AUTH_ADMIN_USERNAME=admin

# Traefik
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Container resources
ML_MEMORY_LIMIT=2g
ML_CPU_LIMIT=2.0

# Directory containing the production secret files
ML_SECRETS_DIR=./secrets/prod
